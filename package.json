{
  "name": "atenea",
  "version": "0.1.0",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "lint": "eslint",
    "db:seed": "tsx app/seed.ts",
    "electron:dev": "wait-on tcp:3000 && cross-env NODE_ENV=development ELECTRON_START_URL=http://localhost:3000 electron electron/main.cjs",
    "dev:electron": "concurrently -k \"npm run dev\" \"npm run electron:dev\"",
    "start:electron": "cross-env NODE_ENV=production electron electron/main.cjs",
    "build:electron": "npm run build && electron-builder --dir",
    "dist:electron": "npm run build && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html2pdf": "^0.0.11",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "next": "16.1.6",
    "prisma": "^6.19.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^37.7.1",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.atenea.desktop",
    "productName": "Atenea",
    "icon": "electron/icon.png",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!**/.git/**",
      "!**/.next/cache/**",
      "!**/node_modules/.cache/**",
      "!**/*.log",
      "!**/.env*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
